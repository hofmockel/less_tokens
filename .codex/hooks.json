    },
    {
      "event": "PostToolUse",
      "matcher": "Bash",
      "command": "LESS_TOKENS_AGENT=codex .less_tokens/bin/python .codex/hooks/lean-output.py"
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "LESS_TOKENS_AGENT=codex .less_tokens/bin/python .codex/hooks/listing-guard.py"
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|mcp__filesystem__.*",
      "command": "LESS_TOKENS_AGENT=codex .less_tokens/bin/python .codex/hooks/truncate-output.py"
    },
    {
      "event": "PostToolUse",
      "matcher": ".*",
      "command": "LESS_TOKENS_AGENT=codex .less_tokens/bin/python .codex/hooks/compact-trigger.py"
    },
    {
      "event": "PostToolUse",
      "matcher": ".*",
      "command": "LESS_TOKENS_AGENT=codex .less_tokens/bin/python .codex/hooks/savings-html.py"
    }
